rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'defaultMonthlyBudget',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'defaultMonthlyBudget',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 60 &&
        (data.defaultMonthlyBudget is int || data.defaultMonthlyBudget is float) &&
        data.defaultMonthlyBudget >= 0 &&
        data.defaultMonthlyBudget <= 100000000000 &&
        data.onboardingCompleted is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMonthlyBudget(data, userId, monthId) {
      return data.keys().hasAll([
          'ownerId',
          'monthId',
          'label',
          'shortLabel',
          'monthAbbr',
          'monthNumber',
          'year',
          'totalDays',
          'monthlyBudget',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'monthId',
          'label',
          'shortLabel',
          'monthAbbr',
          'monthNumber',
          'year',
          'totalDays',
          'monthlyBudget',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isValidId(data.monthId) &&
        data.monthId == monthId &&
        data.monthId.size() >= 7 &&
        data.monthId.size() <= 16 &&
        data.label is string &&
        data.label.size() >= 1 &&
        data.label.size() <= 40 &&
        data.shortLabel is string &&
        data.shortLabel.size() >= 1 &&
        data.shortLabel.size() <= 20 &&
        data.monthAbbr is string &&
        data.monthAbbr.size() >= 1 &&
        data.monthAbbr.size() <= 10 &&
        data.monthNumber is int &&
        data.monthNumber >= 1 &&
        data.monthNumber <= 12 &&
        data.year is int &&
        data.year >= 2000 &&
        data.year <= 2100 &&
        data.totalDays is int &&
        data.totalDays >= 28 &&
        data.totalDays <= 31 &&
        (data.monthlyBudget is int || data.monthlyBudget is float) &&
        data.monthlyBudget >= 0 &&
        data.monthlyBudget <= 100000000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMovement(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'monthId',
          'type',
          'day',
          'dateISO',
          'dateLabel',
          'category',
          'description',
          'amount',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'monthId',
          'type',
          'day',
          'dateISO',
          'dateLabel',
          'category',
          'description',
          'amount',
          'paymentMethod',
          'notes',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isValidId(data.monthId) &&
        data.monthId.size() >= 7 &&
        data.monthId.size() <= 16 &&
        data.type is string &&
        data.type.size() <= 16 &&
        (data.type == 'expense' || data.type == 'income') &&
        data.day is int &&
        data.day >= 1 &&
        data.day <= 31 &&
        data.dateISO is string &&
        data.dateISO.size() == 10 &&
        data.dateISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.dateLabel is string &&
        data.dateLabel.size() >= 1 &&
        data.dateLabel.size() <= 30 &&
        data.category is string &&
        data.category.size() >= 1 &&
        data.category.size() <= 60 &&
        data.description is string &&
        data.description.size() >= 1 &&
        data.description.size() <= 200 &&
        (data.amount is int || data.amount is float) &&
        data.amount > 0 &&
        data.amount <= 100000000000 &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 40)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (data.clientCreatedAt is int || data.clientCreatedAt is float) &&
        data.clientCreatedAt >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'defaultMonthlyBudget', 'onboardingCompleted', 'updatedAt'])
        ) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if false;

      match /months/{monthId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(monthId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(monthId) &&
          isValidMonthlyBudget(incoming(), userId, monthId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(monthId) &&
          isValidMonthlyBudget(incoming(), userId, monthId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'updatedAt'])
          ) &&
          incoming().ownerId == existing().ownerId &&
          incoming().monthId == existing().monthId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if false;
      }

      match /movements/{movementId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(movementId);
        allow list: if isOwner(userId) && isValidId(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(movementId) &&
          isValidMovement(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(movementId) &&
          isValidMovement(incoming(), userId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['description', 'category', 'amount', 'paymentMethod', 'notes', 'updatedAt'])
          ) &&
          incoming().ownerId == existing().ownerId &&
          incoming().monthId == existing().monthId &&
          incoming().type == existing().type &&
          incoming().clientCreatedAt == existing().clientCreatedAt &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(movementId) &&
          existing().ownerId == request.auth.uid;
      }
    }
  }
}
