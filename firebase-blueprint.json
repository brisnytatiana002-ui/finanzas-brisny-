{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado y configuración inicial de presupuesto de un usuario autenticado.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID único del usuario en Firebase Auth.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico de la cuenta.",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Nombre visible del usuario.",
          "minLength": 1,
          "maxLength": 60
        },
        "defaultMonthlyBudget": {
          "type": "number",
          "description": "Presupuesto mensual base en COP configurado inicialmente."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Indica si el usuario ya completó la configuración inicial de presupuesto."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor cuando se creó el perfil."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor de la última actualización."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "defaultMonthlyBudget",
        "onboardingCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Configuración de presupuesto mensual por período para un usuario.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID del propietario de este presupuesto mensual.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthId": {
          "type": "string",
          "description": "Identificador del mes en formato YYYY-MM.",
          "minLength": 7,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "description": "Nombre legible del mes.",
          "minLength": 1,
          "maxLength": 40
        },
        "shortLabel": {
          "type": "string",
          "description": "Etiqueta corta del mes.",
          "minLength": 1,
          "maxLength": 20
        },
        "monthAbbr": {
          "type": "string",
          "description": "Abreviatura del mes.",
          "minLength": 1,
          "maxLength": 10
        },
        "monthNumber": {
          "type": "number",
          "description": "Número del mes (1-12)."
        },
        "year": {
          "type": "number",
          "description": "Año calendario."
        },
        "totalDays": {
          "type": "number",
          "description": "Total de días del mes."
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Presupuesto base del mes en COP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor de creación."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor de actualización."
        }
      },
      "required": [
        "ownerId",
        "monthId",
        "label",
        "shortLabel",
        "monthAbbr",
        "monthNumber",
        "year",
        "totalDays",
        "monthlyBudget",
        "createdAt",
        "updatedAt"
      ]
    },
    "BudgetMovement": {
      "title": "BudgetMovement",
      "description": "Movimiento financiero individual (gasto o ingreso) perteneciente a un usuario.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID del propietario del movimiento.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthId": {
          "type": "string",
          "description": "Identificador del mes al que pertenece (YYYY-MM).",
          "minLength": 7,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["expense", "income"],
          "description": "Tipo de movimiento: gasto o ingreso.",
          "maxLength": 16
        },
        "day": {
          "type": "number",
          "description": "Día del mes (1-31)."
        },
        "dateISO": {
          "type": "string",
          "description": "Fecha en formato ISO YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dateLabel": {
          "type": "string",
          "description": "Etiqueta legible de fecha.",
          "minLength": 1,
          "maxLength": 30
        },
        "category": {
          "type": "string",
          "description": "Categoría del gasto o ingreso.",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "description": "Descripción breve del movimiento.",
          "minLength": 1,
          "maxLength": 200
        },
        "amount": {
          "type": "number",
          "description": "Valor en pesos colombianos COP (> 0)."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Medio de pago utilizado.",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "description": "Observaciones opcionales.",
          "maxLength": 500
        },
        "clientCreatedAt": {
          "type": "number",
          "description": "Marca numérica para orden cronológico estable."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor de creación."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor de actualización."
        }
      },
      "required": [
        "ownerId",
        "monthId",
        "type",
        "day",
        "dateISO",
        "dateLabel",
        "category",
        "description",
        "amount",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Perfil privado y presupuesto inicial por cuenta de usuario."
    },
    "/users/{userId}/months/{monthId}": {
      "schema": {
        "$ref": "#/entities/MonthlyBudget"
      },
      "description": "Presupuestos mensuales configurados exclusivamente para cada usuario."
    },
    "/users/{userId}/movements/{movementId}": {
      "schema": {
        "$ref": "#/entities/BudgetMovement"
      },
      "description": "Gastos e ingresos registrados exclusivamente para cada usuario."
    }
  }
}
